#!/bin/bash
# Exécuté au premier démarrage de la VM : installe Docker et lance le traitement.
set -euxo pipefail
dnf install -y docker
systemctl enable --now docker

docker run -d --name processor --restart always \
  -e DATABASE_URL='${database_url}' \
  -e S3_ENDPOINT='' -e S3_ACCESS_KEY='' -e S3_SECRET_KEY='' \
  -e S3_REGION='${region}' -e S3_BUCKET='${bucket}' \
  -e PROCESS_INTERVAL='${process_interval}' \
  '${image}'
